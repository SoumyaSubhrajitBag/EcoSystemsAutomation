<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<configSections>
		<sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral">
			<section name="ASW.TestLab.Functional.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
		</sectionGroup>
		<sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
			<section name="ASW.TestLab.Functional.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
		</sectionGroup>
	</configSections>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
	</startup>
	<runtime>
		<!--Assembly Redirection: Any updates to the WebDriver Assmeblies will require the redirections to be updated.  Profile Plugins
     also contain a reference to the WebDriver Assemblies, and without the proper redirection, would require the Profiles to be recompiled
     for every WebDriver Assmebly Update. -->
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<!-- WebDriver.dll -->
			<dependentAssembly>
				<assemblyIdentity name="WebDriver" publicKeyToken="1c2bd1631853048f" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-2.52.0.0" newVersion="2.53.0" />
			</dependentAssembly>
			<!-- WebDriver.Support.dll -->
			<dependentAssembly>
				<assemblyIdentity name="WebDriver.Support" publicKeyToken="1c2bd1631853048f" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-2.52.0.0" newVersion="2.53.0.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Windows.Interactivity" publicKeyToken="31bf3856ad364e35" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.5.0.0" newVersion="4.5.0.0" />
			</dependentAssembly>
		</assemblyBinding>
	</runtime>
	<userSettings>
		<ASW.TestLab.Functional.Properties.Settings>
			<setting name="BrowserType" serializeAs="String">
				<value>GoogleChrome</value>
			</setting>
			<setting name="BrowserURL" serializeAs="String">
				<value />
			</setting>
			<setting name="CreateNewBrowser" serializeAs="String">
				<value>True</value>
			</setting>
			<setting name="StepByStep" serializeAs="String">
				<value>False</value>
			</setting>
			<setting name="DateFormatString" serializeAs="String">
				<value>M/d/yyyy</value>
			</setting>
			<setting name="ServerUserName" serializeAs="String">
				<value>admin</value>
			</setting>
			<setting name="DefaultServerUrl" serializeAs="String">
				<value>http://localhost:8080/DuckCreek/DCTServer.aspx</value>
			</setting>
			<setting name="ServerRequest" serializeAs="String">
				<value>
					<server>
						<requests>
							<Session.loginRq userName="admin" password="admin" />
							<Session.closeRq />
						</requests>
					</server>
				</value>
			</setting>
			<setting name="IterationType" serializeAs="String">
				<value>Single</value>
			</setting>
			<setting name="RunOption" serializeAs="String">
				<value>CreateNewBrowser</value>
			</setting>
			<setting name="LocateTimeout" serializeAs="String">
				<value>30000</value>
			</setting>
			<setting name="DefaultUrl" serializeAs="String">
				<value>about:blank</value>
			</setting>
			<setting name="SingleStep" serializeAs="String">
				<value>False</value>
			</setting>
			<setting name="IncludeTagNameInXPathForFields" serializeAs="String">
				<value>True</value>
			</setting>
			<setting name="IncludeTagNameInXPathForActions" serializeAs="String">
				<value>True</value>
			</setting>
			<setting name="CommandLineMode" serializeAs="String">
				<value>False</value>
			</setting>
			<setting name="IgnoreIEProtectedMode" serializeAs="String">
				<value>True</value>
			</setting>
			<setting name="HighlightElements" serializeAs="String">
				<value>False</value>
			</setting>
			<setting name="StayHighlighted" serializeAs="String">
				<value>False</value>
			</setting>
			<setting name="SelectedProfileId" serializeAs="String">
				<value>d6506b66-39a2-4b14-a311-debb6d5a4dbd</value>
			</setting>
			<setting name="DefaultPageCaptureProfileId" serializeAs="String">
				<value>d6506b66-39a2-4b14-a311-debb6d5a4dbd</value>
			</setting>
			<setting name="DateTimeFormatString" serializeAs="String">
				<value>M/d/yyyy h:mm:ss tt</value>
			</setting>
			<setting name="ErrorThreshold" serializeAs="String">
				<value>5</value>
			</setting>
			<setting name="MaxRetries" serializeAs="String">
				<value>2</value>
			</setting>
			<setting name="Use64BitIE" serializeAs="String">
				<value>False</value>
			</setting>
			<setting name="AutoMoveMouseCursor" serializeAs="String">
				<value>True</value>
			</setting>
			<setting name="SynchronizationTimeout" serializeAs="String">
				<value>70000</value>
			</setting>
			<setting name="AutoSaveReportLog" serializeAs="String">
				<value>False</value>
			</setting>
			<setting name="AutoSaveDirectory" serializeAs="String">
				<value />
			</setting>
			<setting name="MaximizeBrowserWindow" serializeAs="String">
				<value>True</value>
			</setting>
			<setting name="Setting" serializeAs="String">
				<value>0</value>
			</setting>
			<setting name="PerformanceThreshold" serializeAs="String">
				<value>6000</value>
			</setting>
			<setting name="UserDefinedServerUrl" serializeAs="String">
				<value>http://localhost:8080/DuckCreek/DCTServer.aspx</value>
			</setting>
			<setting name="IEElementScrollBehavior" serializeAs="String">
				<value>Top</value>
			</setting>
			<setting name="PageLoadTimeout" serializeAs="String">
				<value>30000</value>
			</setting>
			<setting name="EnablePersistantMouseHover" serializeAs="String">
				<value>False</value>
			</setting>
			<setting name="ForceWindowFocus" serializeAs="String">
				<value>True</value>
			</setting>
			<setting name="ScreenshotMode" serializeAs="String">
				<value>Never</value>
			</setting>
			<setting name="DefaultSynchronizationProfileId" serializeAs="String">
				<value>d6506b66-39a2-4b14-a311-debb6d5a4dbd</value>
			</setting>
			<setting name="OptionCoveragePercentage" serializeAs="String">
				<value>75</value>
			</setting>
			<setting name="HighComplexity" serializeAs="String">
				<value>10</value>
			</setting>
			<setting name="MediumComplexity" serializeAs="String">
				<value>5</value>
			</setting>
			<setting name="EnableIEDebug" serializeAs="String">
				<value>False</value>
			</setting>
			<setting name="IEEnableNativeEvents" serializeAs="String">
				<value>False</value>
			</setting>
			<setting name="ShowStepNumbers" serializeAs="String">
				<value>False</value>
			</setting>
			<setting name="HighlightOnHover" serializeAs="String">
				<value>False</value>
			</setting>
			<setting name="SynchronizationThinkTime" serializeAs="String">
				<value>1000</value>
			</setting>
		</ASW.TestLab.Functional.Properties.Settings>
	</userSettings>
	<applicationSettings>
		<ASW.TestLab.Functional.Properties.Settings>
			<setting name="AnalysisIsEnabled" serializeAs="String">
				<value>False</value>
			</setting>
			<setting name="MRUScriptKey" serializeAs="String">
				<value>ASW.TestLab.Functional.TestScriptMRU</value>
			</setting>
			<setting name="MRUBatchKey" serializeAs="String">
				<value>ASW.TestLab.Functional.BatchListMRU</value>
			</setting>
			<setting name="DocumentationUrlTAC" serializeAs="String">
				<value>https://solutioncenter.duckcreek.com</value>
			</setting>
			<setting name="IgnoreSSLCertificateErrors" serializeAs="String">
				<value>True</value>
			</setting>
		</ASW.TestLab.Functional.Properties.Settings>
	</applicationSettings>
</configuration>