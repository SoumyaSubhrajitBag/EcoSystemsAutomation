    private void PrepareData()
    {
        string filePath = configuration["InputExcel"]; // @"X:\Automation DataDump\InputExcel.xlsx";
        var list = PullPolicyNumbers(filePath);
        if (list != null && list.Count > 0)
        {
            createDailyAutomationFolder(filePath);
            ods.ExtractPolicies(list);
        }
    }



    private List<string> PullPolicyNumbers(string filePath)
    {
        // List to store Policy# values
        List<string> policyNumbers = new List<string>();

        // Ensure the file exists
        if (!System.IO.File.Exists(filePath))
        {
            Console.WriteLine($"File not found: {filePath}");
            return null;
        }

        // Load the Excel file
        using (var workbook = new XLWorkbook(filePath))
        {
            var worksheet = workbook.Worksheet(1); // Assuming the data is in the first worksheet

            // Find the "Policy#" and "Status" column indexes
            int policyColumnIndex = 0;
            int statusColumnIndex = 0;
            int transColumnIndex = 0;
            int lobColumnIndex = 0;

            // Read the header row (assumes headers are in the first row)
            var headerRow = worksheet.Row(1);
            foreach (var cell in headerRow.CellsUsed())
            {
                string header = cell.GetString().Trim();
                if (header.Equals("Policy#", StringComparison.OrdinalIgnoreCase))
                    policyColumnIndex = cell.Address.ColumnNumber;
                else if (header.Equals("Status", StringComparison.OrdinalIgnoreCase))
                    statusColumnIndex = cell.Address.ColumnNumber;
                else if (header.Equals("Transaction", StringComparison.OrdinalIgnoreCase))
                    transColumnIndex = cell.Address.ColumnNumber;
                else if (header.Equals("LOB", StringComparison.OrdinalIgnoreCase))
                    lobColumnIndex = cell.Address.ColumnNumber;
            }

            if (policyColumnIndex == 0 || statusColumnIndex == 0)
            {
                Console.WriteLine("Required columns not found.");
                return null;
            }

            // Iterate through the rows starting from the second row
            foreach (var row in worksheet.RowsUsed().Skip(1))
            {
                string status = row.Cell(statusColumnIndex).GetString().Trim();
                string lob = row.Cell(lobColumnIndex).GetString().Trim();
                string transaction = row.Cell(transColumnIndex).GetString().Trim();
                if (status.Equals("Pass", StringComparison.OrdinalIgnoreCase) && (lob.Equals("GL") || lob.Equals("CX")) && transaction.Equals("New Business",StringComparison.OrdinalIgnoreCase))
                {
                    string policyNumber = row.Cell(policyColumnIndex).GetString().Trim();
                    policyNumbers.Add(policyNumber);
                }
            }

            foreach (var row in policyNumbers)
            {
                Console.WriteLine(row);
            }
        }

        return policyNumbers;

    }

    private void createDailyAutomationFolder(string filePath)
    {
        string parentFolder = Path.GetDirectoryName(filePath);

        if (string.IsNullOrEmpty(parentFolder))
        {
            Console.WriteLine("Invalid file path.");
            return;
        }

        // Format the current date as "yyyy-MM-dd"
        string currentDateFolderName = DateTime.Now.ToString("MM-dd-yyyy");

        // Create the full path for the new folder
        string newFolderPath = Path.Combine(parentFolder, currentDateFolderName);


        // Create the folder if it doesn't already exist
        if (!Directory.Exists(newFolderPath))
        {
            Directory.CreateDirectory(newFolderPath);
            Console.WriteLine($"Folder created: {newFolderPath}");
        }
        else
        {
            Console.WriteLine($"Folder already exists: {newFolderPath}");
        }

        if (!File.Exists(Path.Combine(newFolderPath, Path.GetFileName(filePath))))
            File.Copy(filePath, Path.Combine(newFolderPath, Path.GetFileName(filePath)));
    }


