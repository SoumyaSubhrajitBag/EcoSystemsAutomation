    private async Task HandleOperation(Action operation, string operationName)
    {
        try
        {
            // Set the appropriate flag based on operation
            switch (operationName)
            {
                case "Data Extraction": isExtractRunning = true; break;
                case "ALA-EX-CRT-AMS-BILL-CLM-PAM-NOC-EPM": isPass1Running = true; break;
                case "LC360-UAT": isPass2Running = true; break;
                // case "EX-BILL-CLM-PAM": isPass3Running = true; break;
                // case "NOC-EPM": isPass4Running = true; break;
                // case "EPM-AMS_CRT": isPass5Running = true; break;
            }

            await Task.Run(operation);

            NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Success",
                    Detail = $"{operationName} completed successfully",
                    Duration = 4000
                });
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Error",
                    Detail = $"Error in {operationName}: {ex.Message}",
                    Duration = 4000
                });
        }
        finally
        {
            // Reset the appropriate flag
            switch (operationName)
            {
                case "Data Extraction": isExtractRunning = false; break;
                case "ALA-EX-CRT-AMS-BILL-CLM-PAM-NOC-EPM": isPass1Running = false; break;
                case "LC360-UAT": isPass2Running = false; break;
                // case "EX-BILL-CLM-PAM": isPass3Running = false; break;
                // case "NOC-EPM": isPass4Running = false; break;
                // case "EPM-AMS_CRT": isPass5Running = false; break;
            }
        }
    }

